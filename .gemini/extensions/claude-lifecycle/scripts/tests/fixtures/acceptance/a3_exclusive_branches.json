{
  "schema_version": "2.0",
  "id": "ecom-winback-01",
  "version": "1.0.0",
  "journey_class": "marketing",
  "name": "Winback",
  "pattern": "winback",
  "stage": "winback",
  "priority": "P0",
  "data_tier": "T2",
  "dqs": 55,
  "depth_class": "standard",
  "objective": "Bring lapsed buyers back to a second purchase.",
  "constraints": {
    "allowed_channels": [
      "email",
      "sms",
      "push"
    ],
    "max_discount_pct": 15
  },
  "trigger": {
    "type": "segment_entry",
    "value": "lapsed_buyers"
  },
  "audience": {
    "include": "bought before, no purchase in 2x median gap",
    "exclude": [
      "open refund"
    ]
  },
  "events_available": [
    "purchase",
    "email_unsubscribe",
    "consent_withdrawn",
    "link_click",
    "add_to_cart",
    "trial_end",
    "feature_used",
    "subscription_start"
  ],
  "exit": {
    "success_event": "purchase",
    "success_window": "P30D",
    "exit_conditions": [
      {
        "event": "purchase",
        "source": "authoritative",
        "check": [
          "entry",
          "before_each_send"
        ]
      },
      {
        "event": "consent_withdrawn",
        "source": "authoritative",
        "check": [
          "entry",
          "before_each_send"
        ]
      }
    ]
  },
  "reentry": {
    "policy": "after_cooldown",
    "cooldown": "P90D",
    "on_duplicate_trigger": "ignore"
  },
  "measurement": {
    "design": "holdout",
    "primary_outcome": {
      "event": "purchase",
      "window": "P30D"
    },
    "holdout": {
      "pct": 10,
      "assignment": {
        "unit": "user",
        "consistent": true,
        "method": "hash(user_id)"
      },
      "control_excludes": [
        "all sends in this journey"
      ]
    },
    "routine_comms": [
      {
        "name": "transactional order emails",
        "both_groups": true
      }
    ],
    "contamination_risks": [
      "users also in browse-abandonment"
    ],
    "volume_note": "~400 entrants/month: detects only large lifts in one month"
  },
  "start": "entry",
  "nodes": [
    {
      "id": "entry",
      "kind": "entry",
      "next": "m1"
    },
    {
      "id": "m1",
      "kind": "message",
      "channel": "email",
      "purpose": "marketing",
      "intent": "email touch m1",
      "send": {
        "from": "entry",
        "offset": "P0D"
      },
      "next": "d1"
    },
    {
      "id": "d1",
      "kind": "decision",
      "signal": {
        "type": "click",
        "name": "link_click",
        "source": "engagement",
        "bot_filtered": true
      },
      "window": {
        "from": {
          "from": "node",
          "node": "m1",
          "offset": "P0D"
        },
        "to": {
          "from": "entry",
          "offset": "P2D"
        }
      },
      "branches": [
        {
          "when": "occurred",
          "next": "a1"
        },
        {
          "when": "not_occurred",
          "next": "b1"
        }
      ],
      "unmeasurable": "b1"
    },
    {
      "id": "a1",
      "kind": "message",
      "channel": "email",
      "purpose": "marketing",
      "intent": "email touch a1",
      "send": {
        "from": "node",
        "node": "d1",
        "offset": "P1D"
      },
      "next": "m9"
    },
    {
      "id": "b1",
      "kind": "message",
      "channel": "sms",
      "purpose": "marketing",
      "intent": "sms touch b1",
      "send": {
        "from": "node",
        "node": "d1",
        "offset": "P1D"
      },
      "next": "m9"
    },
    {
      "id": "done",
      "kind": "exit",
      "reason": "completed",
      "outcome": "neutral"
    },
    {
      "id": "m9",
      "kind": "message",
      "channel": "email",
      "purpose": "marketing",
      "intent": "email touch m9",
      "send": {
        "from": "node",
        "node": "d1",
        "offset": "P5D"
      },
      "next": "done"
    }
  ],
  "kpis": [
    {
      "name": "Incremental repurchase",
      "type": "primary",
      "definition": "purchase rate exposed minus control"
    },
    {
      "name": "Unsubscribe rate",
      "type": "guardrail",
      "definition": "unsubscribes / delivered"
    }
  ],
  "readiness": "ready"
}