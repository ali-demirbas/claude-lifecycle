{
 "schema_version": "2.0",
 "id": "saas-feedback-nps-01",
 "version": "1.0.0",
 "journey_class": "marketing",
 "name": "NPS",
 "pattern": "feedback-nps",
 "stage": "retention",
 "priority": "P0",
 "data_tier": "T2",
 "dqs": 55,
 "depth_class": "standard",
 "objective": "Bring lapsed buyers back to a second purchase.",
 "constraints": {
  "allowed_channels": [
   "email",
   "push",
   "in_app"
  ]
 },
 "trigger": {
  "type": "segment_entry",
  "value": "lapsed_buyers"
 },
 "audience": {
  "include": "bought before, no purchase in 2x median gap",
  "exclude": [
   "open refund"
  ]
 },
 "events_available": [
  "add_to_cart",
  "consent_granted",
  "consent_withdrawn",
  "email_unsubscribe",
  "feature_used",
  "link_click",
  "purchase",
  "push_opt_out",
  "subscription_start",
  "survey_response",
  "survey_score",
  "trial_end"
 ],
 "exit": {
  "success_event": "purchase",
  "success_window": "P30D",
  "exit_conditions": [
   {
    "event": "purchase",
    "source": "authoritative",
    "check": [
     "entry",
     "before_each_send"
    ]
   },
   {
    "event": "push_opt_out",
    "source": "authoritative",
    "check": [
     "before_each_send"
    ],
    "scope": "channel",
    "channel": "push"
   },
   {
    "event": "email_unsubscribe",
    "source": "authoritative",
    "check": [
     "before_each_send"
    ],
    "scope": "channel",
    "channel": "email"
   },
   {
    "event": "consent_withdrawn",
    "source": "authoritative",
    "check": [
     "entry",
     "before_each_send"
    ]
   }
  ]
 },
 "reentry": {
  "policy": "after_cooldown",
  "cooldown": "P90D",
  "on_duplicate_trigger": "ignore"
 },
 "measurement": {
  "design": "holdout",
  "primary_outcome": {
   "event": "purchase",
   "window": "P30D"
  },
  "holdout": {
   "pct": 10,
   "assignment": {
    "unit": "user",
    "consistent": true,
    "method": "hash(user_id)"
   },
   "control_excludes": [
    "all sends in this journey"
   ]
  },
  "routine_comms": [
   {
    "name": "transactional order emails",
    "both_groups": true
   }
  ],
  "contamination_risks": [
   "users also in browse-abandonment"
  ],
  "volume_note": "~400 entrants/month: detects only large lifts in one month"
 },
 "start": "entry",
 "nodes": [
  {
   "id": "entry",
   "kind": "entry",
   "next": "q1"
  },
  {
   "id": "q1",
   "kind": "message",
   "channel": "email",
   "purpose": "service",
   "intent": "NPS ask",
   "send": {
    "from": "entry",
    "offset": "P2D"
   },
   "next": "d1"
  },
  {
   "id": "d1",
   "kind": "decision",
   "signal": {
    "type": "attribute",
    "name": "survey_score",
    "source": "authoritative"
   },
   "window": {
    "from": {
     "from": "entry",
     "offset": "P2D"
    },
    "to": {
     "from": "entry",
     "offset": "P5D"
    }
   },
   "branches": [
    {
     "when": ">= 9",
     "next": "p1"
    },
    {
     "when": "<= 6",
     "next": "r1"
    }
   ],
   "default": "t1",
   "unmeasurable": "t1"
  },
  {
   "id": "p1",
   "kind": "message",
   "channel": "in_app",
   "purpose": "marketing",
   "intent": "Promoters only: native App Store / Google Play review prompt (public store rating)",
   "send": {
    "from": "entry",
    "offset": "P5D"
   },
   "delivery": {
    "mode": "next_session",
    "expires_after": "P3D"
   },
   "next": "done"
  },
  {
   "id": "r1",
   "kind": "message",
   "channel": "email",
   "purpose": "service",
   "intent": "Detractors: private feedback form instead of the store",
   "send": {
    "from": "entry",
    "offset": "P5D"
   },
   "next": "done"
  },
  {
   "id": "t1",
   "kind": "message",
   "channel": "email",
   "purpose": "service",
   "intent": "Passives: thank-you",
   "send": {
    "from": "entry",
    "offset": "P5D"
   },
   "next": "done"
  },
  {
   "id": "done",
   "kind": "exit",
   "reason": "completed",
   "outcome": "neutral"
  }
 ],
 "kpis": [
  {
   "name": "Incremental repurchase",
   "type": "primary",
   "definition": "purchase rate exposed minus control"
  },
  {
   "name": "Unsubscribe rate",
   "type": "guardrail",
   "definition": "unsubscribes / delivered"
  }
 ],
 "readiness": "ready"
}